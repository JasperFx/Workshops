<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <!-- Class libraries that expose HTTP endpoints need the ASP.NET Core
             framework reference; the package references alone don't bring it. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Marten" />
        <PackageReference Include="WolverineFx.Http" />
        <PackageReference Include="WolverineFx.Http.Marten" />
        <PackageReference Include="WolverineFx.Marten" />
    </ItemGroup>

    <ItemGroup>
        <!-- Contracts, and nothing else. Note in particular: no reference to
             HelpDesk.Customers, even though this module reacts to customer
             data. That is the whole point. -->
        <ProjectReference Include="../HelpDesk.Contracts/HelpDesk.Contracts.csproj" />
    </ItemGroup>

</Project>
